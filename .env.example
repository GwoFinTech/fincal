# Domain & Auth
# Your public domain (used in Traefik routing labels)
DOMAIN=fincal.example.com

# ForwardAuth middleware name (Traefik label reference)
# Set to forwardauth@docker or your custom middleware
AUTH_MIDDLEWARE=forwardauth@docker

# Auth login URL - where unauthenticated users are redirected
# Leave empty to hide login button (single-user mode)
AUTH_LOGIN_URL=

# Database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fincal
DB_USER=postgres
DB_PASSWORD=changeme

# Watchlist Source: tsummt (direct DB) or http (remote API)
# See docs/watchlist-source.md for details
WATCHLIST_SOURCE=tsummt
# WATCHLIST_HTTP_URL=https://example.com/api/watchlist
# WATCHLIST_HTTP_FIELD=code
# TSUMMT_DB=tsummt

# Futu OpenD (optional)
# FUTU_HOST=127.0.0.1
# FUTU_PORT=11112
# Per-symbol call watchdog windows (seconds) for scripts/sync_futu.py
# FUTU_DATES_TIMEOUT_SECONDS=15
# FUTU_ACTUALS_TIMEOUT_SECONDS=20
# OpenD pacing for scripts/sync_futu.py — OpenD refuses both financials
# interfaces above 30 calls / 30 s; the default budget keeps headroom and a
# rejected call waits one window before its bounded retry. A stage that keeps
# getting refused stops early (circuit breaker) and is audited as
# futu_rate_limited rather than as symbol failures.
# FUTU_MAX_CALLS_PER_30S=28
# FUTU_RATE_LIMIT_WINDOW_SECONDS=30
# FUTU_RATE_LIMIT_MAX_RETRIES=2
# FUTU_RATE_LIMIT_CIRCUIT_BREAKER=10

# Longbridge CLI (optional)
# Run longbridge auth to configure
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=

# iCal subscription base URL (must be publicly accessible)
ICAL_BASE_URL=https://fincal.example.com

# Sync freshness monitoring (Issue #53)
# A sync stage (or the derived table it feeds) older than this is reported as
# stale by scripts/check_sync_freshness.py and /api/admin/health. Default 192h
# = weekly schedule + 1 day of grace.
# SYNC_STAGE_STALE_AFTER_HOURS=192
# Window used by /api/admin/diagnostics for the sync-run summary. The pipeline
# runs weekly, so a 24h window is empty most days; 336h (14 days) covers at
# least one full cycle. The legacy `sync_runs_24h` field is still returned.
# SYNC_RUNS_WINDOW_HOURS=336
