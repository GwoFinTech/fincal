# Domain & Auth
# Your public domain (used in Traefik routing labels)
DOMAIN=fincal.example.com

# ForwardAuth middleware name (Traefik label reference)
# Set to forwardauth@docker or your custom middleware
AUTH_MIDDLEWARE=forwardauth@docker

# Auth login URL - where unauthenticated users are redirected
# Leave empty to hide login button (single-user mode)
AUTH_LOGIN_URL=

# Database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fincal
DB_USER=postgres
DB_PASSWORD=changeme

# Watchlist Source: tsummt (direct DB) or http (remote API)
# See docs/watchlist-source.md for details
WATCHLIST_SOURCE=tsummt
# WATCHLIST_HTTP_URL=https://example.com/api/watchlist
# WATCHLIST_HTTP_FIELD=code
# TSUMMT_DB=tsummt
# Default calendar/export universe freshness (Issue #58). The universe follows
# the watchlist source instead of being frozen at container start; a source
# outage uses the shorter retry backoff.
# UNIVERSE_CACHE_TTL_SECONDS=120
# UNIVERSE_ERROR_RETRY_SECONDS=15

# Kurumi / tsummt API — preferred company-name source for FinCal symbols
# (app/company_name.py asks {KURUMI_API_URL}/api/stock/{symbol}/overview).
# REQUIRED for the container: the built-in default is http://localhost:8000,
# which inside the container is FinCal's OWN listen port — the dependency probe
# cannot fail against it and /api/admin/health reports
# `dependency_not_configured` instead of a false `healthy` (Issue #70). Point it
# at an address the container can actually reach (e.g. the tsummt-api service on
# the Docker network); the host-side sync stage reads it from the host, where
# localhost:8000 is tsummt-api itself.
# KURUMI_API_URL=http://tsummt-api:8000
# KURUMI_API_TIMEOUT=5

# Futu OpenD (optional)
# FUTU_HOST=127.0.0.1
# FUTU_PORT=11112
# Per-symbol call watchdog windows (seconds) for scripts/sync_futu.py
# FUTU_DATES_TIMEOUT_SECONDS=15
# FUTU_ACTUALS_TIMEOUT_SECONDS=20
# OpenD pacing for scripts/sync_futu.py — OpenD refuses both financials
# interfaces above 30 calls / 30 s; the default budget keeps headroom and a
# rejected call waits one window before its bounded retry. A stage that keeps
# getting refused stops early (circuit breaker) and is audited as
# futu_rate_limited rather than as symbol failures.
# FUTU_MAX_CALLS_PER_30S=28
# FUTU_RATE_LIMIT_WINDOW_SECONDS=30
# FUTU_RATE_LIMIT_MAX_RETRIES=2
# FUTU_RATE_LIMIT_CIRCUIT_BREAKER=10

# Longbridge CLI (optional)
# Run longbridge auth to configure
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=

# iCal subscription base URL (must be publicly accessible)
ICAL_BASE_URL=https://fincal.example.com

# Forward horizon of the calendar read outlets (Issue #59): the iCal feed and the
# default window of /api/earnings. Must stay >= scripts/predict_earnings.py
# MAX_FUTURE_DAYS (420 = 4 predicted quarters), otherwise predicted events are
# computed and stored but never delivered to a subscription. Narrow it only for
# clients with a hard event-count limit — that re-introduces the gap.
# CALENDAR_FORWARD_DAYS=420

# Sync freshness monitoring (Issue #53)
# A sync stage (or the derived table it feeds) older than this is reported as
# stale by scripts/check_sync_freshness.py and /api/admin/health. Default 192h
# = weekly schedule + 1 day of grace.
# SYNC_STAGE_STALE_AFTER_HOURS=192
# Window used by /api/admin/diagnostics for the sync-run summary. The pipeline
# runs weekly, so a 24h window is empty most days; 336h (14 days) covers at
# least one full cycle. The legacy `sync_runs_24h` field is still returned.
# SYNC_RUNS_WINDOW_HOURS=336

# Sync-run timeout reaper (Issue #33). `sync_runs.timeout_seconds` is written for
# every run; the app now actually reads it. A run whose owning process died (a
# stage killed by the cron wrapper's `timeout`, a container restart mid-run) is
# interrupted once its own timeout has elapsed, checked every interval below.
# Set SYNC_RUN_REAPER_ENABLED=false to turn the periodic reaper off — startup and
# manual recovery (`POST /api/admin/sync-runs/recover`) are unaffected.
# SYNC_RUN_REAPER_ENABLED=true
# SYNC_RUN_REAPER_INTERVAL_SECONDS=300

# Per-stage wall-clock budgets of the weekly pipeline (Issue #78), in seconds.
# `scripts/sync_all.sh` enforces them with `timeout`, exports them, and each
# stage script declares the same number in its own `sync_runs` row — the reaper
# judges a run by that column, so the two halves MUST be the same number:
#   a stage killed by `timeout` is then terminal within its own budget plus one
#   reaper interval, instead of waiting out the generic 3600s default.
# Raise one only together with the stage's real runtime; a budget larger than the
# row's `timeout_seconds` (or vice versa) re-creates the ghost-`running` row or
# makes the reaper interrupt a stage that is still alive.
# FINCAL_STAGE_TIMEOUT_LONGBRIDGE=900
# FINCAL_STAGE_TIMEOUT_FUTU=1500
# FINCAL_STAGE_TIMEOUT_STOCK_NAMES=900
# FINCAL_STAGE_TIMEOUT_CONSENSUS=2400
# FINCAL_STAGE_TIMEOUT_PREDICTION=600
